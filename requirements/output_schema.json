{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "2308.TW Dashboard Data Payload",
  "type": "object",
  "required": ["symbol", "exchange", "currency", "longName", "previousClose", "price", "open", "dayHigh", "dayLow", "volume", "change", "changePercent", "fiftyTwoWeekHigh", "fiftyTwoWeekLow", "updatedAt", "history"],
  "properties": {
    "symbol": {
      "type": "string",
      "enum": ["2308.TW"]
    },
    "exchange": {
      "type": "string",
      "pattern": "^TPE$|^TAI$"
    },
    "currency": {
      "type": "string",
      "enum": ["TWD"]
    },
    "longName": {
      "type": "string"
    },
    "previousClose": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "open": {
      "type": ["number", "null"]
    },
    "dayHigh": {
      "type": ["number", "null"]
    },
    "dayLow": {
      "type": ["number", "null"]
    },
    "volume": {
      "type": "integer",
      "minimum": 0
    },
    "change": {
      "type": "number"
    },
    "changePercent": {
      "type": "number"
    },
    "fiftyTwoWeekHigh": {
      "type": "number"
    },
    "fiftyTwoWeekLow": {
      "type": "number"
    },
    "updatedAt": {
      "type": "integer",
      "description": "UTC Unix timestamp for the current quote moment"
    },
    "history": {
      "type": "object",
      "required": ["1mo", "1y"],
      "properties": {
        "1mo": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/historyBar"
          }
        },
        "1y": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/historyBar"
          }
        }
      }
    }
  },
  "definitions": {
    "historyBar": {
      "type": "object",
      "required": ["date", "close"],
      "properties": {
        "date": {
          "type": "integer",
          "description": "YYYYMMDD integer, e.g. 20260723"
        },
        "open": {
          "type": ["number", "null"]
        },
        "high": {
          "type": ["number", "null"]
        },
        "low": {
          "type": ["number", "null"]
        },
        "close": {
          "type": "number"
        },
        "volume": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  },
  "notes": {
    "source": "Yahoo Finance chart endpoint, query1.finance.yahoo.com",
    "primaryApiEndpoint": "https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?interval=1d&range={range}",
    "usefulRanges": ["1d", "5d", "1mo", "3mo", "6mo", "1y", "2y", "5y", "10y", "ytd", "max"],
    "apiKeyRequired": false,
    "policyAssumption": "personal non-commercial dashboard with one symbol only"
  }
}
